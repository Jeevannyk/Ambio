# ── LiveKit rooms setup (video calls) ─────────────────────────────────
# 1. Create a free project at https://cloud.livekit.io
# 2. Open Settings -> Keys and copy the API key, secret, and project URL
# 3. Paste them below, then run the token server:  npm run server
# These are SERVER-SIDE only — never exposed to the browser.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Port for the token server (optional, defaults to 3001).
PORT=3001

# ── Support form (Web3Forms) ──────────────────────────────────────────
# Real-time contact form — delivers messages to your inbox, no backend.
# 1. Go to https://web3forms.com  -> enter your email -> get an Access Key
#    (the key is tied to your email server-side; your email stays out of the code)
# 2. Paste the key below. Safe to expose in the frontend.
VITE_WEB3FORMS_KEY=

# ── Supabase auth (real login) ────────────────────────────────────────
# 1. Create a project at https://supabase.com (free)
# 2. Settings → API → copy "Project URL" and the "anon / public" key
# 3. Authentication → Providers → enable Email (and Google if you want OAuth)
# Both values are PUBLIC — safe in the frontend (RLS protects your data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
